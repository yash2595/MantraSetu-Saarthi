# ==============================================================================
# MantraSetu AgentOS Production Environment Configuration & Secrets Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Profile
# ------------------------------------------------------------------------------
# Set ENVIRONMENT to 'production' for strict validation, or 'development' for local mock mode.
ENVIRONMENT=production

# Disable debug mode in production environments to prevent leaking tracebacks.
DEBUG=false

# Structured logging verbosity level: INFO, WARN, ERROR, DEBUG.
LOG_LEVEL=INFO

# Network binding host IP address (0.0.0.0 binds to all network interfaces).
APP_HOST=0.0.0.0

# Network port for HTTP/WebSocket server entrypoint.
APP_PORT=8000

# Number of worker processes for multi-process concurrency in production.
WORKERS_COUNT=4

# Explicitly allow mock providers in development/testing mode (true/false).
ALLOW_MOCK_PROVIDERS=false

# ------------------------------------------------------------------------------
# 2. Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access and refresh tokens (MUST be at least 32 bytes).
JWT_SECRET_KEY=change_this_to_a_secure_random_production_secret_32bytes_min

# Cryptographic algorithm for JWT token signatures (HS256, RS256, etc.).
JWT_ALGORITHM=HS256

# Expiration window in minutes for short-lived access tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Expiration window in days for long-lived refresh tokens.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. Production Databases & Connection Pools
# ------------------------------------------------------------------------------
# PostgreSQL database connection URI string.
POSTGRES_URL=postgresql://mantrasetu_user:SecurePassword123!@postgres:5432/mantrasetu_production

# Maximum persistent connection pool size for PostgreSQL.
POSTGRES_POOL_SIZE=50

# Maximum overflow connections permitted beyond pool size.
POSTGRES_MAX_OVERFLOW=20

# Redis connection URI for distributed session storage and caching.
REDIS_URL=redis://redis:6379/0

# Maximum active connections for Redis client pool.
REDIS_MAX_CONNECTIONS=100

# MongoDB URI for unstructured audit log persistence.
MONGODB_URL=mongodb://mongo:27017/mantrasetu_audit

# MongoDB database name.
MONGODB_DB_NAME=mantrasetu_audit

# ------------------------------------------------------------------------------
# 4. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
# Qdrant Vector Store cluster endpoint URL.
QDRANT_HOST=http://qdrant:6333

# Qdrant gRPC port for high-performance vector ops.
QDRANT_GRPC_PORT=6334

# Qdrant authentication token for cluster access.
QDRANT_API_KEY=your_production_qdrant_api_key_here

# Default vector collection name for dense embedding retrieval.
QDRANT_DEFAULT_COLLECTION=mantrasetu_pujas

# ------------------------------------------------------------------------------
# 5. Production AI Provider API Keys
# ------------------------------------------------------------------------------
# OpenAI Platform API key for GPT-4o and text-embedding-3-small models.
OPENAI_API_KEY=sk-proj-your_production_openai_api_key_here

# Sarvam AI API key for Hinglish LLM, STT, and TTS synthesis.
SARVAM_API_KEY=your_production_sarvam_ai_api_key_here

# Qwen 3 Omni / Qwen Voice API key for multimodal streaming.
QWEN_API_KEY=your_production_qwen_api_key_here

# ------------------------------------------------------------------------------
# 6. Default AI Providers & Priorities
# ------------------------------------------------------------------------------
# Default LLM provider choice (openai_gpt4o, qwen3_omni, sarvam_ai_llm).
DEFAULT_LLM_PROVIDER=openai_gpt4o

# Default vector embedding provider (openai_embed, sarvam_embed).
DEFAULT_EMBEDDING_PROVIDER=openai_embed

# Default Speech-to-Text provider (whisper_stt, sarvam_stt).
DEFAULT_STT_PROVIDER=sarvam_stt

# Default Text-to-Speech provider (sarvam_tts, qwen_voice_tts, openai_realtime_tts).
DEFAULT_TTS_PROVIDER=sarvam_tts

# ------------------------------------------------------------------------------
# 7. WebSocket Channel Configuration
# ------------------------------------------------------------------------------
# Ping probe interval in seconds for active WebSocket sessions.
WS_HEARTBEAT_INTERVAL_SEC=15

# Maximum reconnection attempts before timing out client session.
WS_RECONNECT_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 8. Production Feature Flags
# ------------------------------------------------------------------------------
# Enable audio byte streaming over WebSocket channels.
ENABLE_VOICE_STREAMING=true

# Enable Hinglish transcript normalization for voice requests.
ENABLE_HINGLISH_STT=true

# Enable automatic exception recovery coordinator.
ENABLE_AUTO_RECOVERY=true

# Enable telemetry recording and metric collection.
ENABLE_TELEMETRY=true
